<Window x:Class="RubiksCubeSolver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RubiksCubeSolver.ViewModels"
        xmlns:controls="clr-namespace:RubiksCubeSolver.Controls"
        Title="Rubik's Cube Solver"
        Icon="pack://application:,,,/Assets/app.png"
        Height="940" Width="1480"
        MinHeight="780" MinWidth="1280"
        Background="{StaticResource BgBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Margin="0,0,0,12" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Rubik's Cube Solver" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Test mode (no hardware)" IsChecked="{Binding TestMode}"
                              VerticalAlignment="Center" Margin="0,0,16,0"
                              ToolTip="Scramble and solve on the digital cube only. No Maestro, webcam, or robot motion."/>
                    <Button Content="Refresh devices" Command="{Binding RefreshDevicesCommand}" Background="{StaticResource PanelAltBrush}"/>
                    <Button Content="Connect" Command="{Binding ConnectCommand}" Background="{StaticResource BlueBrush}"/>
                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Background="{StaticResource PanelAltBrush}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel}" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding CameraResolution, StringFormat=Camera {0}}" Foreground="{StaticResource MutedBrush}"/>
                </Grid>
                <ProgressBar Value="{Binding Progress}" Maximum="1" Margin="0,8,0,12"/>
                <WrapPanel>
                    <Button Content="Load" Command="{Binding LoadCommand}" Background="{StaticResource OkBrush}" Foreground="#102016"
                            ToolTip="Open arms. Insert the cube with the Rubik's logo (white face) facing the camera."/>
                    <Button Content="Unload" Command="{Binding UnloadCommand}" Background="{StaticResource PanelAltBrush}"/>
                    <Button Content="Start" Command="{Binding StartCommand}" Background="{StaticResource AccentBrush}"/>
                    <Button Content="Scramble" Command="{Binding ScrambleCommand}" Background="{StaticResource ScrambleBrush}" Foreground="#08201C"
                            ToolTip="Hug and run a random 20-move scramble on the cube."/>
                    <Button Content="Zen Mode" Command="{Binding ZenModeCommand}" Background="{StaticResource ZenBrush}"
                            ToolTip="Scan, solve, retract left/right/top to display, wait 15 seconds, scramble, and repeat. If a scan is already solved, scramble first. Stop to end."/>
                    <Button Content="Stop" Command="{Binding StopCommand}" Background="{StaticResource StopBrush}"/>
                    <Button Content="Camera" Command="{Binding CameraPreviewPoseCommand}" Background="{StaticResource BlueBrush}"/>
                    <Button Content="Servos off" Command="{Binding ServosOffCommand}" Background="{StaticResource PanelAltBrush}"/>
                    <Button Content="Solve net" Command="{Binding SolveNetCommand}" Background="{StaticResource PanelAltBrush}" Margin="0"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <TabControl>
            <TabItem Header="Control">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Panel}" Margin="0,0,10,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="WEBCAM" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Use camera" Command="{Binding ApplyCameraCommand}"
                                        Background="{StaticResource BlueBrush}" MinWidth="110" Margin="8,0,0,0"/>
                                <ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}"
                                          ToolTip="Choose the robot webcam"/>
                            </DockPanel>
                            <Border Background="#0C0E12" CornerRadius="8" ClipToBounds="True">
                                <Image Source="{Binding CameraImage}" Stretch="Uniform"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="0,0,10,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="DIGITAL CUBE" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="Turns with the robot. Click the net below to fix a color." Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            </StackPanel>
                            <Viewbox DockPanel.Dock="Bottom" Stretch="Uniform" Height="140" Margin="0,8,0,0">
                                <Grid x:Name="CubeNetHost" Width="420" Height="320"/>
                            </Viewbox>
                            <Border Background="#0C0E12" CornerRadius="8" ClipToBounds="True">
                                <controls:Cube3DView x:Name="CubeView" Stickers="{Binding Stickers}"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Panel}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="STATUS" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding SolutionText}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                                         TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                         FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Scan grid">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Panel}" Margin="0,0,10,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="LIVE GRID" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,8"
                                       Text="Connect the webcam, press Hug cube (auto-calibrates the grid), or press Auto calibrate on a framed face. Fine-tune with sliders if needed, then Keep these settings."/>
                            <Border Background="#0C0E12" CornerRadius="8" ClipToBounds="True">
                                <Image Source="{Binding CameraImage}" Stretch="Uniform"/>
                            </Border>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Panel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="STICKER READ" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding ScanPreviewStickers}" Width="168" Height="168" HorizontalAlignment="Left" Margin="0,0,0,16">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="3" Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Brush}" Margin="3" CornerRadius="4"
                                                    BorderBrush="#F5D000" BorderThickness="2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="GRID" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Grid size" VerticalAlignment="Center"
                                               ToolTip="Drag right to make the 3×3 bigger. 0.40–0.50 on Edge inset was the smallest grid."/>
                                    <Slider Grid.Column="1" Minimum="0.16" Maximum="1" Value="{Binding FaceGridSize, Mode=TwoWay}"
                                            SmallChange="0.01" LargeChange="0.05"
                                            ToolTip="Right = bigger square. Left = smaller square."/>
                                    <TextBlock Grid.Column="2" Text="{Binding FaceGridSize, StringFormat=F2}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Move right" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="-0.35" Maximum="0.35" Value="{Binding FaceOffsetX, Mode=TwoWay}"
                                            SmallChange="0.005" LargeChange="0.02"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FaceOffsetX, StringFormat=F2}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Move down" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="-0.35" Maximum="0.35" Value="{Binding FaceOffsetY, Mode=TwoWay}"
                                            SmallChange="0.005" LargeChange="0.02"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FaceOffsetY, StringFormat=F2}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Box inset" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0.04" Maximum="0.42" Value="{Binding FaceSampleInset, Mode=TwoWay}"
                                            SmallChange="0.005" LargeChange="0.02"
                                            ToolTip="Larger inset keeps each yellow box inside the sticker, off the plastic gaps."/>
                                    <TextBlock Grid.Column="2" Text="{Binding FaceSampleInset, StringFormat=F2}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                                </Grid>

                                <CheckBox Content="Rotate photos 180°" IsChecked="{Binding Settings.RotatePhotos180}" Margin="0,0,0,8"/>
                                <CheckBox Content="Auto-find face during scans" IsChecked="{Binding FaceAutoDetect}" Margin="0,0,0,12"
                                          ToolTip="When on, each scan photo finds the face square automatically (perspective warp). Best for angled views. Auto calibrate sets the manual grid instead."/>

                                <WrapPanel>
                                    <Button Content="Hug cube" Command="{Binding HugForScanGridCommand}" Background="{StaticResource OkBrush}" Foreground="#102016"/>
                                    <Button Content="Auto calibrate" Command="{Binding AutoCalibrateScanGridCommand}" Background="{StaticResource OkBrush}" Foreground="#102016"/>
                                    <Button Content="Reset grid" Command="{Binding ResetScanGridCommand}" Background="{StaticResource PanelAltBrush}"/>
                                    <Button Content="Keep these settings" Command="{Binding SaveScanGridCommand}" Background="{StaticResource AccentBrush}" Margin="0"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Calibration">
                <ScrollViewer Margin="0,10,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Servo calibration" FontWeight="SemiBold"/>
                                <TextBlock Text="Pulse widths in microseconds. Even channels are grippers, odd channels are arms. Dual tumbles move one gripper to Turn end and the other the same distance below Start. For a full 90° pitch, set left/right turner min to 256 in Maestro Control Center so the downward gripper is not clipped at 496." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8"/>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Serial port" Width="120" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding SerialPorts}" SelectedItem="{Binding SelectedPort}" DisplayMemberPath="Caption"/>
                                </DockPanel>
                                <WrapPanel>
                                    <CheckBox Content="Test mode (no hardware)" IsChecked="{Binding TestMode}" Margin="0,0,16,8"/>
                                    <CheckBox Content="Rotate photos 180°" IsChecked="{Binding Settings.RotatePhotos180}" Margin="0,0,16,8"/>
                                    <CheckBox Content="Invert pitch (L/R tumble)" IsChecked="{Binding Settings.InvertPitch}" Margin="0,0,16,8"
                                              ToolTip="Reverse the left/right roll direction if the cube tumbles the wrong way during scan."/>
                                    <CheckBox Content="Invert yaw (U/D tumble)" IsChecked="{Binding Settings.InvertYaw}" Margin="0,0,16,8"
                                              ToolTip="Reverse the top/bottom roll direction if the cube spins the wrong way during scan."/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Video settle ms" Width="120" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Settings.VideoDurationMs}" Width="80" Margin="0,0,16,0"/>
                                    <TextBlock Text="Scan frames" Width="90" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Settings.ScanFramesPerFace}" Width="50" Margin="0,0,16,0"
                                             ToolTip="Photos averaged per side during scan (1–12). More frames = better color read, slower scan."/>
                                    <TextBlock Text="Scan hold squeeze" Width="120" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Settings.ScanHoldSqueezeUs}" Width="60" Margin="0,0,16,0"
                                             ToolTip="Extra grip for photos when one arm pair holds the cube."/>
                                    <TextBlock Text="Turn grip squeeze" Width="110" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Settings.TurnGripSqueezeUs}" Width="60" Margin="0,0,16,0"
                                             ToolTip="Lighter grip for 90° turns (lower = less stall). Try 60–100."/>
                                    <TextBlock Text="Hug TB backoff µs" Width="120" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Settings.HugTopBottomBackoffUs}" Width="60" Margin="0,0,16,0"
                                             ToolTip="Top/bottom stop this far short of In during hug (150 default). Increase if top/bottom stall or get hot."/>
                                    <TextBlock Text="Turn speed cap" Width="100" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Settings.TurnSpeedCap}" Width="50" Margin="0,0,16,0"
                                             ToolTip="Max turner speed during dual tumbles (lower = gentler). 0 = use calibration."/>
                                    <TextBlock Text="Face margin" Width="90" VerticalAlignment="Center"
                                               ToolTip="Old inset value. 0 = largest grid, 0.42 = smallest. Prefer Grid size on the Scan grid tab."/>
                                    <TextBox Text="{Binding FaceMargin}" Width="80" Margin="0,0,16,0"/>
                                    <TextBlock Text="Settle ms" Width="80" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Settings.SettleMs}" Width="80" Margin="0,0,16,0"/>
                                    <TextBlock Text="Tumble squeeze" Width="110" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Settings.TumbleSqueezeUs}" Width="80" Margin="0,0,16,0"
                                             ToolTip="Extra microseconds past In when two grippers roll together, so the center turns with the cube."/>
                                    <TextBlock Text="Pitch extra µs" Width="110" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Settings.PitchExtraUs}" Width="80" Margin="0,0,16,0"
                                             ToolTip="Keep at 0 unless Top/Bottom pitch stops short of square."/>
                                    <TextBlock Text="Tumble trim µs" Width="110" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Settings.TumbleTrimUs}" Width="80"
                                             ToolTip="Subtract from pair yaw/pitch. Use 15–25 if Left/Right go past 90° (about 92°)."/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Auto calibrate turns" Command="{Binding HugAndAutoCalibrateTurnsAsyncCommand}"
                                            Background="{StaticResource OkBrush}" Foreground="#102016" Margin="0,0,12,0"
                                            ToolTip="Hug cube, derive turn grip/speed/trim from your arm calibration, then test one gentle yaw turn."/>
                                    <Button Content="Auto calibrate turns (no hug)" Command="{Binding AutoCalibrateTurnSettingsCommand}" Margin="0,0,12,0"
                                            ToolTip="Test turn only — cube should already be hugged."/>
                                    <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Background="{StaticResource AccentBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding TurnCalibrationSummary}" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8"/>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource Panel}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Right turner  ·  port 0" FontWeight="SemiBold"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="Port" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.RightTurner.Port}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="Start" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.RightTurner.StartUs}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="Turn end" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.RightTurner.EndUs}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="Other way" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.RightTurner.OppositeEndUs}" Width="70"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="8,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Right arm  ·  port 1" FontWeight="SemiBold"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="Port" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.RightArm.Port}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="In" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.RightArm.InUs}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="Out" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.RightArm.OutUs}" Width="70"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Top turner  ·  port 2" FontWeight="SemiBold"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="Port" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.TopTurner.Port}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="Start" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.TopTurner.StartUs}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="Turn end" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.TopTurner.EndUs}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="Other way" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.TopTurner.OppositeEndUs}" Width="70"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="8,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Top arm  ·  port 3" FontWeight="SemiBold"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="Port" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.TopArm.Port}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="In" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.TopArm.InUs}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="Out" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.TopArm.OutUs}" Width="70"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Left turner  ·  port 6" FontWeight="SemiBold"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="Port" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.LeftTurner.Port}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="Start" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.LeftTurner.StartUs}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="Turn end" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.LeftTurner.EndUs}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="Other way" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.LeftTurner.OppositeEndUs}" Width="70"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="8,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Left arm  ·  port 7" FontWeight="SemiBold"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="Port" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.LeftArm.Port}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="In" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.LeftArm.InUs}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="Out" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.LeftArm.OutUs}" Width="70"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Bottom turner  ·  port 8" FontWeight="SemiBold"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="Port" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.BottomTurner.Port}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="Start" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.BottomTurner.StartUs}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="Turn end" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.BottomTurner.EndUs}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="Other way" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.BottomTurner.OppositeEndUs}" Width="70"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="8,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Bottom arm  ·  port 9" FontWeight="SemiBold"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="Port" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.BottomArm.Port}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="In" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.BottomArm.InUs}" Width="70" Margin="0,0,12,4"/>
                                        <TextBlock Text="Out" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Settings.BottomArm.OutUs}" Width="70"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
