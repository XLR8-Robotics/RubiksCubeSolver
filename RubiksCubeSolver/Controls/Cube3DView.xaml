<UserControl x:Class="RubiksCubeSolver.Controls.Cube3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0C0E12"
             ClipToBounds="True">
    <Grid>
        <Viewport3D x:Name="Viewport">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="Cam"
                                   Position="3.6,2.6,5.4"
                                   LookDirection="-3.6,-2.6,-5.4"
                                   UpDirection="0,1,0"
                                   FieldOfView="40"/>
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup x:Name="Root">
                        <AmbientLight Color="#FFB0B0B0"/>
                        <DirectionalLight Color="White" Direction="-0.35,-0.9,-0.45"/>
                        <DirectionalLight Color="#FFFFF2E0" Direction="0.6,0.15,0.7"/>
                        <DirectionalLight Color="#FF88AADD" Direction="-0.8,0.2,0.3"/>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>
        <TextBlock x:Name="HintText"
                   Text="Drag to rotate · scroll to zoom"
                   Foreground="#6693A0B5"
                   FontSize="11"
                   Margin="10"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   IsHitTestVisible="False"/>
        <TextBlock x:Name="MoveLabel"
                   Foreground="#FFFF7A3C"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="10"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   IsHitTestVisible="False"/>
    </Grid>
</UserControl>
